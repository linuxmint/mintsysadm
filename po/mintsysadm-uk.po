#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1305
msgid "Mark as tracked"
msgstr "Позначити як відстежуване"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1272
#, python-format
msgid "Stop tracking the %s series?"
msgstr "Припинити відстеження серії %s?"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1276
msgid ""
"Without tracking, this computer will no longer receive security updates for "
"this kernel series."
msgstr ""
"Без відстеження цей комп’ютер більше не отримуватиме оновлень безпеки для "
"цієї серії ядер."

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1296
#, python-format
msgid "Mark the %s series as tracked?"
msgstr "Позначити серію %s як відстежувану?"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1300
msgid ""
"This series will be considered manually tracked. It is your responsibility "
"to ensure that an appropriate metapackage is installed or that kernel "
"updates are handled another way."
msgstr ""
"Ця серія вважатиметься відстежуваною вручну. Ви несете відповідальність за "
"те, щоб було встановлено відповідний метапакунок або щоб оновлення ядра "
"виконувалися іншим способом."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:104
