#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:107
#: usr/share/mintsysadm/mintsysadm.ui.h:47
msgid "Hybrid sleep"
msgstr "Hybride slaapstand"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:130
msgid "Suspend-to-idle (s2idle)"
msgstr "Sluimerstand (s2idle)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:131
msgid "Suspend-to-RAM (S3)"
msgstr "Slaapopslag in RAM (S3)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:132
msgid "Shallow (S1)"
msgstr "Ondiep (S1)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:146
msgid "Platform (the firmware powers off)"
msgstr "Platform (de firmware schakelt de stroom uit)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:147
msgid "Shutdown (the kernel powers off)"
msgstr "Uitschakelen (de systeemkern schakelt de stroom uit)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:211
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:223
msgid "Default"
msgstr "Standaard"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:213
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:225
#, python-format
msgid "Default — %s"
msgstr "Standaard — %s"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:288
msgid "The kernel does not support suspend."
msgstr "De systeemkern ondersteunt geen pauzestand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:292
msgid "The kernel supports suspend."
msgstr "De systeemkern ondersteunt pauzestand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:293
#, python-format
msgid "The kernel supports suspend. Method in use: %s."
msgstr "De systeemkern ondersteunt pauzestand. Methode in gebruik: %s."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:297
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:298
msgid "Kernel support"
msgstr "Ondersteuning voor systeemkern"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:297
msgid "The kernel supports hibernation."
msgstr "De systeemkern ondersteunt slaapstand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:298
msgid "The kernel does not support hibernation."
msgstr "De systeemkern ondersteunt slaapstand niet."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:313
msgid "Secure Boot"
msgstr "Secure Boot"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:315
msgid "Secure Boot is enabled and the kernel lockdown prevents hibernation."
msgstr ""
"Secure Boot is ingeschakeld en de systeemkernvergrendeling belemmert "
"slaapstand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:317
msgid "Secure Boot is enabled but the kernel lockdown is not active."
msgstr ""
"Secure Boot is ingeschakeld maar de systeemkernvergrendeling is niet actief."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:318
msgid "Secure Boot is disabled."
msgstr "Secure Boot is uitgeschakeld."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "Swap"
msgstr "Wisselgeheugen"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "No swap partition or swap file is in use."
msgstr "Er is geen wisselgeheugenpartitie of wisselgeheugenbestand actief."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:332
#, python-format
msgid "Swap area in %s"
msgstr "Wisselgeheugengebied in %s"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:340
#, python-format
msgid "The swap area (%(swap)s) is smaller than the memory (%(ram)s)."
msgstr ""
"Het wisselgeheugengebied (%(swap)s) is kleiner dan het geheugen (%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:343
#, python-format
msgid ""
"The swap area (%(swap)s) is at least as large as the memory (%(ram)s)."
msgstr ""
"Het wisselgeheugengebied (%(swap)s) is tenminste even groot als het geheugen "
"(%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:347
msgid "Resume device"
msgstr "Apparaat hervatten"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:350
#, python-format
msgid "The resume device will be set to %s upon reboot."
msgstr ""
"Het hervatten van het apparaat zal worden ingesteld op %s bij herstarten."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:354
#, python-format
msgid ""
"The boot arguments (%s) do not match any swap partition or swap file in use."
msgstr ""
"De opstartparameters (%s) komen niet overeen met enig in gebruik zijnd "
"wisselgeheugen (partitie of bestand)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:358
msgid "The noresume kernel argument is set, which prevents hibernation."
msgstr ""
"De systeemkernparameter noresume is ingesteld, hetgeen slaapstand belemmert."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:362
msgid "No resume device is set."
msgstr "Er is geen apparaathervatting ingesteld."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:379
#, python-format
msgid ""
"The resume offset (%(current)d) does not match the start of %(path)s "
"(%(expected)d)."
msgstr ""
"Het fysieke schijfbloknummer van het wisselgeheugen (%(current)d) komt niet "
"overeen met het begin van %(path)s (%(expected)d)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:381
#, python-format
msgid ""
"The resume device (%(major)d:%(minor)d) does not match any swap partition or "
"swap file in use."
msgstr ""
"De apparaathervatting (%(major)d:%(minor)d) komt niet overeen met enig in "
"gebruik zijnd wisselgeheugen (partitie of bestand)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:385
#, python-format
msgid ""
"The resume device is set to the swap file %(path)s (offset %(offset)d)."
msgstr ""
"De apparaathervatting is ingesteld op het wisselgeheugenbestand %(path)s "
"(offset %(offset)d)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:387
#, python-format
