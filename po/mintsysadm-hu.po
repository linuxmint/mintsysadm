msgstr "Megtartott verziók követett sorozatonként:"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1007
msgid "Kernel version"
msgstr "Rendszermag-verzió"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1014
msgid "Package name"
msgstr "Csomagnév"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1048
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:436
msgid "None"
