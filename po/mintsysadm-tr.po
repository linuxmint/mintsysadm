msgid "Kernel series"
msgstr "Çekirdek serisi"

#: usr/share/mintsysadm/mintsysadm.ui.h:24
msgid ""
"No kernel series are tracked. This computer may not receive kernel security "
"updates.\n"
msgstr ""
"Hiçbir çekirdek serisi izlenmiyor. Bu bilgisayar çekirdek güvenlik "
"güncellemelerini almayabilir.\n"

