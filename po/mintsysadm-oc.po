msgid "Platform (the firmware powers off)"
msgstr "Platafòrma (lo micrologicial arrèsta l’alimentacion)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:147
msgid "Shutdown (the kernel powers off)"
msgstr "Arrèst (lo nuclèu arrèsta l’alimentacion)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:211
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:223
msgid "Default"
