#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:297
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:298
msgid "Kernel support"
msgstr "Kjernestøtte"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:297
msgid "The kernel supports hibernation."
msgstr "Kjernen støttar dvalemodus."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:298
msgid "The kernel does not support hibernation."
msgstr "Kjernen støttar ikkje dvalemodus."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:313
msgid "Secure Boot"
msgstr "Sikker oppstart"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:315
msgid "Secure Boot is enabled and the kernel lockdown prevents hibernation."
msgstr ""
"Sikker oppstart er aktivert og nedlåsing av kjernen hindrar dvalemodus"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:317
msgid "Secure Boot is enabled but the kernel lockdown is not active."
msgstr "Sikker oppstart er aktivert men nedlåsing av kjernen er ikkje aktiv."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:318
msgid "Secure Boot is disabled."
msgstr "Sikker oppstart er deaktivert."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "Swap"
msgstr "Vekselminne"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "No swap partition or swap file is in use."
msgstr "Ingen vekslepartisjon eller vekslefil er i bruk."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:332
#, python-format
msgid "Swap area in %s"
msgstr "Veksleområde i %s"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:340
#, python-format
msgid "The swap area (%(swap)s) is smaller than the memory (%(ram)s)."
msgstr "Veksleområdet (%(swap)s) er mindre enn minnet (%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:343
#, python-format
msgid ""
"The swap area (%(swap)s) is at least as large as the memory (%(ram)s)."
msgstr "Veksleområdet (%(swap)s) er minst like stort som minnet (%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:347
msgid "Resume device"
msgstr "Gjenopptakingseining"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:350
#, python-format
msgid "The resume device will be set to %s upon reboot."
msgstr "Gjenopptakingseininga vil bli sett til %s ved omstart."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:354
#, python-format
msgid ""
"The boot arguments (%s) do not match any swap partition or swap file in use."
msgstr ""
"Oppstartsargumenta (%s) samsvarer ikkje med nokon vekslepartisjon eller "
"vekslefil som er i bruk."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:358
msgid "The noresume kernel argument is set, which prevents hibernation."
msgstr "Kjerneargumentet noresume er sett, noko som hindrar dvalemodus."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:362
msgid "No resume device is set."
msgstr "Ingen gjenopptakingseining er sett."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:379
#, python-format
msgid ""
"The resume offset (%(current)d) does not match the start of %(path)s "
"(%(expected)d)."
msgstr ""
"Gjenopptakingsforskyving (%(current)d) samsvarer ikkje med starten på "
"%(path)s (%(expected)d)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:381
#, python-format
msgid ""
"The resume device (%(major)d:%(minor)d) does not match any swap partition or "
"swap file in use."
msgstr ""
"Gjenopptakingseininga (%(major)d:%(minor)d) samsvarer ikkje med nokon "
"vekslepartisjon eller vekslefil som er i bruk."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:385
#, python-format
msgid ""
"The resume device is set to the swap file %(path)s (offset %(offset)d)."
msgstr ""
"Gjenopptakingseininga er sett til vekslefila %(path)s (offset %(offset)d)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:387
#, python-format
msgid "The resume device is set to %s."
msgstr "Gjenopptakingseininga er sett til %s."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:396
