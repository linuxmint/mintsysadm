msgstr ""
"L'espai d'intercanvi (%(swap)s) és més petit que la memòria (%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:343
#, python-format
msgid ""
"The swap area (%(swap)s) is at least as large as the memory (%(ram)s)."
msgstr ""
"L'espai d'intercanvi (%(swap)s) és almenys tan gran com la memòria (%(ram)s)."

