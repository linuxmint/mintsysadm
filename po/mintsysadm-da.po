msgstr "Standard — %s"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:288
msgid "The kernel does not support suspend."
msgstr "Kernen understøtter ikke hviletilstand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:292
msgid "The kernel supports suspend."
msgstr "Kernen understøtter hviletilstand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:293
#, python-format
msgid "The kernel supports suspend. Method in use: %s."
msgstr "Kernen understøtter hviletilstand. Anvendt metode: %s."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:297
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:298
msgid "Kernel support"
msgstr "Kerneunderstøttelse"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:297
msgid "The kernel supports hibernation."
msgstr "Kernen understøtter dvaletilstand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:298
msgid "The kernel does not support hibernation."
msgstr "Kernen understøtter ikke dvaletilstand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:313
msgid "Secure Boot"
msgstr "Sikker opstart (Secure Boot)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:315
msgid "Secure Boot is enabled and the kernel lockdown prevents hibernation."
msgstr ""
"Sikker opstart er aktiveret, og kernelåsningen forhindrer dvaletilstand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:317
msgid "Secure Boot is enabled but the kernel lockdown is not active."
msgstr "Sikker opstart er aktiveret, og kernelåsningen er ikke aktiv."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:318
msgid "Secure Boot is disabled."
msgstr "Sikker opstart er deaktiveret."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "Swap"
msgstr "Swap"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "No swap partition or swap file is in use."
msgstr "Der er er ingen swappartition eller -fil i brug."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:332
#, python-format
msgid "Swap area in %s"
msgstr "Swapområde i %s"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:340
#, python-format
msgid "The swap area (%(swap)s) is smaller than the memory (%(ram)s)."
msgstr "Swapområdet (%(swap)s) er mindre end hukommelsen (%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:343
#, python-format
msgid ""
"The swap area (%(swap)s) is at least as large as the memory (%(ram)s)."
msgstr ""
"Swapområdet (%(swap)s) er mindst ligeså stor som hukommelsen (%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:347
msgid "Resume device"
msgstr "Genoptagelsesenhed"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:350
#, python-format
msgid "The resume device will be set to %s upon reboot."
msgstr "Genoptagelsesenheden indstilles til %s ved genstart."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:354
#, python-format
msgid ""
"The boot arguments (%s) do not match any swap partition or swap file in use."
msgstr ""
"Bootargumenterne (%s) matcher ikke en swappartition eller -fil, som er i "
"brug."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:358
msgid "The noresume kernel argument is set, which prevents hibernation."
msgstr ""
"Kerneargumentet noresume er angivet, hvilket forhindrer dvaletilstand."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:362
msgid "No resume device is set."
msgstr "Der er ikke angivet en genoptagelsesenhed."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:379
#, python-format
msgid ""
"The resume offset (%(current)d) does not match the start of %(path)s "
"(%(expected)d)."
msgstr ""
"Genoptagelsesforskydningen (resume offset) (%(current)d) stemmer ikke "
"overens med starten på %(path)s (%(expected)d)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:381
#, python-format
msgid ""
"The resume device (%(major)d:%(minor)d) does not match any swap partition or "
"swap file in use."
msgstr ""
"Genoptagelsesenheden (%(major)d:%(minor)d) matcher ikke en swappartition "
"eller -fil, som er i brug."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:385
#, python-format
msgid ""
"The resume device is set to the swap file %(path)s (offset %(offset)d)."
msgstr ""
"Genoptagelsesenheden er indstillet til swapfilen %(path)s (forskydning "
"%(offset)d)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:387
#, python-format
msgid "The resume device is set to %s."
msgstr "Genoptagelsesenheden er indstillet til %s."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:396
msgid "No problems detected"
msgstr "Ingen problemer fundet"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:396
msgid "This computer looks ready for the sleep modes above."
msgstr "Computeren ser ud til at være klar til hviletilstandene ovenfor."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:409
msgid "Set as resume device"
msgstr "Angiv som genoptagelsesenhed"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:434
msgid "The system could not be asked which sleep modes are available."
msgstr ""
"Systemet kunne ikke forespørges, hvilke hviletilstande er tilgængelige."

#: usr/lib/linuxmint/mintsysadm/page_users.py:54
