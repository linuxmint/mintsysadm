#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1065
msgid "(manually tracked)"
msgstr "(śledzone ręcznie)"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1075
msgid "Unknown date"
msgstr "Nieznana data"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1158
msgid "Long Term Support"
msgstr "Długoterminowe wsparcie"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1159
msgid "This is the most stable series. Recommended for most users."
msgstr "To najbardziej stabilna seria. Polecana większości użytkowników."

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1162
msgid "Hardware Enablement"
msgstr "Wdrażanie sprzętu"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1163
msgid "This series is recommended for newer hardware."
msgstr "Ta seria jest zalecana w przypadku nowszego sprzętu."

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1165
msgid ""
"This series sometimes provides newer kernels than the HWE series but without "
"support for proprietary drivers."
msgstr ""
"Ta seria czasami udostępnia nowsze jądra niż seria HWE, jednak bez wsparcia "
"dla własnościowych sterowników."

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1167
msgid "This series is not officially supported."
msgstr "Ta seria nie jest oficjalnie wspierana."

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1177
msgid "Manually tracked"
msgstr "Śledzone ręcznie"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1179
msgid "Tracked"
msgstr "Śledzone"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1205
#, python-format
msgid "Installed kernels: %d"
msgstr "Zainstalowane jądra: %d"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1219
#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1280
msgid "Untrack"
msgstr "Przestań śledzić"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1223
msgid "Track"
msgstr "Śledź"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1234
msgid "Mark as untracked"
msgstr "Oznacz jako nieśledzone"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1241
#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1305
msgid "Mark as tracked"
msgstr "Oznacz jako śledzone"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1272
#, python-format
msgid "Stop tracking the %s series?"
msgstr "Przestać śledzić serię %s?"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1276
msgid ""
"Without tracking, this computer will no longer receive security updates for "
"this kernel series."
msgstr ""
"Bez śledzenia ten komputer przestanie otrzymywać aktualizacje zabezpieczeń "
"dla tej serii jądra."

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1296
#, python-format
msgid "Mark the %s series as tracked?"
msgstr "Oznaczyć serię %s jako śledzoną?"

#: usr/lib/linuxmint/mintsysadm/page_kernels.py:1300
msgid ""
"This series will be considered manually tracked. It is your responsibility "
"to ensure that an appropriate metapackage is installed or that kernel "
"updates are handled another way."
msgstr ""
"Ta seria będzie traktowana jako śledzona ręcznie. Obowiązkiem użytkownika "
"jest upewnienie się, że zainstalowano odpowiedni metapakiet lub że "
"aktualizacje jądra są obsługiwane w inny sposób."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:104
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:285
#: usr/share/mintsysadm/mintsysadm.ui.h:41
msgid "Suspend"
msgstr "Wstrzymaj"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:105
#: usr/share/mintsysadm/mintsysadm.ui.h:43
msgid "Hibernate"
msgstr "Hibernuj"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:106
#: usr/share/mintsysadm/mintsysadm.ui.h:45
msgid "Suspend then hibernate"
msgstr "Wstrzymaj, potem hibernuj"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:107
#: usr/share/mintsysadm/mintsysadm.ui.h:47
msgid "Hybrid sleep"
msgstr "Uśpij hybrydowo"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:130
msgid "Suspend-to-idle (s2idle)"
msgstr "Wstrzymaj do stanu spoczynku (s2idle)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:131
msgid "Suspend-to-RAM (S3)"
msgstr "Wstrzymaj do RAM (S3)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:132
msgid "Shallow (S1)"
msgstr "Płytkie (S1)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:146
msgid "Platform (the firmware powers off)"
msgstr "Platformowe (oprogramowanie sprzętowe wyłącza zasilanie)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:147
msgid "Shutdown (the kernel powers off)"
msgstr "Wyłącz (jądro wyłącza zasilanie)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:211
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:223
msgid "Default"
msgstr "Domyślne"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:213
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:225
#, python-format
msgid "Default — %s"
msgstr "Domyślne — %s"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:288
msgid "The kernel does not support suspend."
msgstr "Jądro nie obsługuje trybu wstrzymania."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:292
msgid "The kernel supports suspend."
msgstr "Jądro obsługuje tryb wstrzymania."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:293
#, python-format
msgid "The kernel supports suspend. Method in use: %s."
msgstr "Jądro obsługuje tryb wstrzymania. Używana metoda: %s."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:297
#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:298
msgid "Kernel support"
msgstr "Obsługa przez jądro"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:297
msgid "The kernel supports hibernation."
msgstr "Jądro obsługuje tryb hibernacji."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:298
msgid "The kernel does not support hibernation."
msgstr "Jądro nie obsługuje trybu hibernacji."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:313
msgid "Secure Boot"
msgstr "Bezpieczny rozruch (Secure Boot)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:315
msgid "Secure Boot is enabled and the kernel lockdown prevents hibernation."
msgstr ""
"Bezpieczny rozruch (Secure Boot) jest włączony, a mechanizm blokady jądra "
"uniemożliwia hibernację."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:317
msgid "Secure Boot is enabled but the kernel lockdown is not active."
msgstr ""
"Bezpieczny rozruch (Secure Boot) jest włączony, ale mechanizm blokady jądra "
"nie jest aktywny."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:318
msgid "Secure Boot is disabled."
msgstr "Bezpieczny rozruch (Secure Boot) jest wyłączony."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "Swap"
msgstr "Pamięć wymiany"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "No swap partition or swap file is in use."
msgstr "Nie jest używana partycja wymiany ani plik wymiany."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:332
#, python-format
msgid "Swap area in %s"
msgstr "Obszar wymiany w %s"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:340
#, python-format
msgid "The swap area (%(swap)s) is smaller than the memory (%(ram)s)."
msgstr "Obszar wymiany (%(swap)s) jest mniejszy niż pamięć (%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:343
#, python-format
msgid ""
"The swap area (%(swap)s) is at least as large as the memory (%(ram)s)."
msgstr ""
"Obszar wymiany (%(swap)s) jest co najmniej tak duży, jak pamięć (%(ram)s)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:347
msgid "Resume device"
msgstr "Urządzenie wznawiania"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:350
#, python-format
msgid "The resume device will be set to %s upon reboot."
msgstr ""
"Urządzenie wznawiania zostanie ustawione na %s po ponownym uruchomieniu "
"komputera."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:354
#, python-format
msgid ""
"The boot arguments (%s) do not match any swap partition or swap file in use."
msgstr ""
"Argumenty rozruchowe (%s) nie odpowiadają żadnej używanej partycji wymiany "
"ani plikowi wymiany."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:358
msgid "The noresume kernel argument is set, which prevents hibernation."
msgstr "Ustawiono parametr jądra „noresume”, co uniemożliwia hibernację."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:362
msgid "No resume device is set."
msgstr "Nie ustawiono urządzenia wznawiania."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:379
#, python-format
msgid ""
"The resume offset (%(current)d) does not match the start of %(path)s "
"(%(expected)d)."
msgstr ""
"Przesunięcie wznowienia (%(current)d) nie zgadza się z początkiem %(path)s "
"(%(expected)d)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:381
#, python-format
msgid ""
"The resume device (%(major)d:%(minor)d) does not match any swap partition or "
"swap file in use."
msgstr ""
"Urządzenie wznawiania (%(major)d:%(minor)d) nie odpowiada żadnej używanej "
