#, python-format
msgid ""
"The resume device (%(major)d:%(minor)d) does not match any swap partition or "
"swap file in use."
msgstr ""
"El dispositivo de reanudación (%(major)d:%(minor)d) no coincide con ninguna "
"partición o archivo de intercambio en uso."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:385
#, python-format
msgid ""
"The resume device is set to the swap file %(path)s (offset %(offset)d)."
msgstr ""
"El dispositivo de reanudación está configurado en el archivo de intercambio "
"%(path)s (desplazamiento %(offset)d)."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:387
#, python-format
msgid "The resume device is set to %s."
msgstr "El dispositivo de reanudación es %s."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:396
