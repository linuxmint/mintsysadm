#, python-format
msgid ""
"The resume offset (%(current)d) does not match the start of %(path)s "
"(%(expected)d)."
msgstr ""
"El offset de reanudación (%(current)d) no coincide con el inicio de %(path)s "
"(%(expected)d)."

