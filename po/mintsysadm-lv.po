"The resume device (%(major)d:%(minor)d) does not match any swap partition or "
"swap file in use."
msgstr ""
"Atsākšanas ierīce (%(major)d:%(minor)d) neatbilst nevienam izmantotajam "
"maiņvietas nodalījumam vai failam."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:385
#, python-format
msgid ""
