msgstr "Ir iestatīts noresume kodola arguments, kas neļauj hibernēt."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:362
msgid "No resume device is set."
msgstr "Nav iestatīta neviena atsākšanas ierīce."

