msgstr "Drošā sāknēšana ir ieslēgta, bet kodola bloķēšana nav aktīva."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:318
msgid "Secure Boot is disabled."
msgstr "Drošā sāknēšana ir atslēgta."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "Swap"
msgstr "Maiņvieta (Swap)"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:323
msgid "No swap partition or swap file is in use."
msgstr "Netiek izmantots neviens maiņvietas nodalījums vai maiņvietas fails."

