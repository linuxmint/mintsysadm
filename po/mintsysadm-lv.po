msgstr "Atsākšanas ierīce"

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:350
#, python-format
msgid "The resume device will be set to %s upon reboot."
msgstr "Pēc restartēšanas atsākšanas ierīce tiks iestatīta uz %s."

#: usr/lib/linuxmint/mintsysadm/page_sleep_modes.py:354
#, python-format
msgid ""
"The boot arguments (%s) do not match any swap partition or swap file in use."
msgstr ""
"Sāknēšanas argumenti (%s) neatbilst nevienam izmantotajam maiņvietas "
"nodalījumam vai failam."

