#: usr/share/mintsysadm/mintsysadm.ui.h:11
msgid ""
"The menu will always be shown if multiple operating systems are installed."
msgstr ""
"Il menù verrà sempre visualizzato se sono installati più sistemi operativi."

#: usr/share/mintsysadm/mintsysadm.ui.h:12
msgid "Delay before booting the default selection (seconds)"
msgstr "Ritardo prima dell'avvio della selezione predefinita (secondi)"

#: usr/share/mintsysadm/mintsysadm.ui.h:13
msgid "Set the delay to -1 if you want the menu to show indefinitely."
msgstr ""
"Imposta il ritardo su -1 se vuoi che il menù rimanga visualizzato a tempo "
"indefinito."

#: usr/share/mintsysadm/mintsysadm.ui.h:14
msgid "0"
msgstr "0"

#: usr/share/mintsysadm/mintsysadm.ui.h:15
msgid "Remember the last selected choice as the default"
msgstr "Ricorda l'ultima scelta selezionata come predefinita"

#: usr/share/mintsysadm/mintsysadm.ui.h:16
msgid "Boot parameters"
msgstr "Parametri di avvio"

#: usr/share/mintsysadm/mintsysadm.ui.h:17
msgid "The computer booted with the following parameters:"
msgstr "Il computer si è avviato con i seguenti parametri:"

#: usr/share/mintsysadm/mintsysadm.ui.h:18
msgid ""
"In addition to the system configuration you can set your own parameters in "
"the list below"
msgstr ""
"Oltre alla configurazione del sistema, è possibile impostare i propri "
"parametri nell'elenco sottostante"

#: usr/share/mintsysadm/mintsysadm.ui.h:19
msgid "Press Save and reboot the computer for changes to take effect."
msgstr ""
"Fai clic su Salva e riavvia il computer per rendere effettive le modifiche."

#: usr/share/mintsysadm/mintsysadm.ui.h:20
msgid "Save"
msgstr "Salva"

#: usr/share/mintsysadm/mintsysadm.ui.h:21
msgid "Boot Menu"
msgstr "Menù di avvio"

#: usr/share/mintsysadm/mintsysadm.ui.h:23
msgid "Kernel series"
msgstr "Serie del kernel"

#: usr/share/mintsysadm/mintsysadm.ui.h:24
msgid ""
"No kernel series are tracked. This computer may not receive kernel security "
"updates.\n"
msgstr ""
"Non viene monitorata alcuna serie del kernel. Questo computer potrebbe non "
"ricevere aggiornamenti di sicurezza del kernel.\n"

#: usr/share/mintsysadm/mintsysadm.ui.h:26
msgid "View all kernels"
msgstr "Visualizza tutti i kernel"

#: usr/share/mintsysadm/mintsysadm.ui.h:27
msgid "Automatic cleanup"
msgstr "Pulizia automatica"

#: usr/share/mintsysadm/mintsysadm.ui.h:28
msgid "Cleanup runs weekly."
msgstr "La pulizia viene eseguita settimanalmente."

#: usr/share/mintsysadm/mintsysadm.ui.h:29
msgid "Remove older kernels automatically"
msgstr "Rimuove automaticamente i kernel più vecchi"

#: usr/share/mintsysadm/mintsysadm.ui.h:30
msgid "Number of installed kernels to keep in each tracked series"
msgstr "Numero di kernel installati da mantenere in ogni serie monitorata"

#: usr/share/mintsysadm/mintsysadm.ui.h:31
msgid "The active kernel and tracked metapackages are always protected."
msgstr "Il kernel attivo e i metapacchetti monitorati sono sempre protetti."

#: usr/share/mintsysadm/mintsysadm.ui.h:32
msgid "History"
msgstr "Cronologia"

#: usr/share/mintsysadm/mintsysadm.ui.h:33
msgid "Clean up now"
msgstr "Pulisci ora"

#: usr/share/mintsysadm/mintsysadm.ui.h:34
msgid "Kernels"
msgstr "Kernel"

#: usr/share/mintsysadm/mintsysadm.ui.h:35
msgid "Environment variables"
msgstr "Variabili d'ambiente"

#: usr/share/mintsysadm/mintsysadm.ui.h:36
msgid "Set system-wide environment variables using the NAME=VALUE format."
msgstr ""
"Imposta le variabili d'ambiente a livello di sistema utilizzando il formato "
"NOME=VALORE."

#: usr/share/mintsysadm/mintsysadm.ui.h:37
msgid "Log out and log back in for changes to take effect."
msgstr ""
"Disconnettiti e accedi nuovamente affinché le modifiche abbiano effetto."

#: usr/share/mintsysadm/mintsysadm.ui.h:38
msgid "Environment Variables"
msgstr "Variabili d'ambiente"

#: usr/share/mintsysadm/mintsysadm.ui.h:39
msgid "Allowed sleep modes"
msgstr "Modalità di sospensione consentite"

#: usr/share/mintsysadm/mintsysadm.ui.h:40
msgid "Choose the sleep modes you want to allow."
msgstr "Seleziona le modalità di sospensione che desideri abilitare."

#: usr/share/mintsysadm/mintsysadm.ui.h:42
msgid ""
"Keeps the session in memory (RAM). The computer is still running but uses "
"only a bit of power."
msgstr ""
"Mantiene la sessione in memoria (RAM). Il computer resta attivo, ma consuma "
"pochissima energia."

#: usr/share/mintsysadm/mintsysadm.ui.h:44
msgid "Saves the session to disk (Swap). Shuts down the computer."
msgstr "Salva la sessione su disco (Swap). Spegne il computer."

#: usr/share/mintsysadm/mintsysadm.ui.h:46
msgid ""
"Suspends for a while (systemd decides how long, based on battery power), "
"then hibernates."
msgstr ""
"Si sospende per un certo periodo (systemd decide per quanto tempo, in base "
"alla carica della batteria), dopodiché va in ibernazione."

#: usr/share/mintsysadm/mintsysadm.ui.h:48
msgid "Suspends but also saves the session to disk (Swap)."
msgstr "Sospende la sessione ma la salva anche su disco (Swap)."

#: usr/share/mintsysadm/mintsysadm.ui.h:49
msgid "Suspend method"
msgstr "Metodo di sospensione"

#: usr/share/mintsysadm/mintsysadm.ui.h:50
msgid ""
"This is the method used to suspend the computer. Only the methods offered by "
"your BIOS/firmware can be chosen."
msgstr ""
"Questo è il metodo utilizzato per sospendere il computer. È possibile "
"scegliere solo i metodi offerti dal BIOS/firmware."

#: usr/share/mintsysadm/mintsysadm.ui.h:51
msgid "Hibernation method"
msgstr "Metodo di ibernazione"

#: usr/share/mintsysadm/mintsysadm.ui.h:52
msgid "This is method used to power off the computer during hibernation."
msgstr ""
"Questo è il metodo utilizzato per spegnere il computer durante l'ibernazione."

#: usr/share/mintsysadm/mintsysadm.ui.h:53
msgid "Current state"
msgstr "Stato attuale"

#: usr/share/mintsysadm/mintsysadm.ui.h:54
msgid "Fix any detected issues to make allowed sleep modes available."
msgstr ""
"Risolvi eventuali problemi rilevati per rendere disponibili le modalità di "
"sospensione consentite."

#: usr/share/mintsysadm/mintsysadm.ui.h:55
msgid "Available sleep modes"
msgstr "Modalità di sospensione disponibili"

#: usr/share/mintsysadm/mintsysadm.ui.h:56
msgid "These sleep modes should work right now."
msgstr ""
"Queste modalità di sospensione dovrebbero funzionare correttamente al "
"momento."

#: usr/share/mintsysadm/mintsysadm.ui.h:57
msgid "Sleep Modes"
msgstr "Modalità di sospensione"

#: usr/share/mintsysadm/mintsysadm.ui.h:59
msgid "Updating the boot menu"
msgstr "Aggiornamento del menù di avvio"
